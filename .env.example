# ===== 必填 =====
# 管理员初始密码（至少 8 位）。首次启动时写入数据库，之后请登录后台修改。
ADMIN_PASSWORD=please-change-me-123

# 忘记密码时临时设为 true，并把 ADMIN_PASSWORD 改为新密码，重启一次后删除本行。
# RESET_ADMIN_PASSWORD=true

# ===== 可选 =====
# 站点名称，显示在页面左上角
SITE_NAME=轻传

# 宿主机映射端口，容器内固定为 3000
SHAREBOX_PORT=8080

# 单文件大小上限（MB）
MAX_UPLOAD_MB=200
# 单次分享所有文件的总大小上限（MB）
MAX_TOTAL_MB=500

# 下载令牌有效期（分钟），大文件下载可适当调大
DOWNLOAD_TOKEN_MINUTES=60

# 部署在 Nginx / Caddy 等反向代理之后时设为 true
TRUST_PROXY=false
# auto / true / false；启用 HTTPS 后建议设为 true
COOKIE_SECURE=auto

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

TZ=Asia/Shanghai
